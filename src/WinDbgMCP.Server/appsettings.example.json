{
  "Vm": {
    "VmName": "<hyper-v-vm-name>",
    "GuestIpAddress": "192.0.2.10",
    "GuestUsername": "<guest-admin>",
    "HostPrivateKeyPath": "",
    "KnownHostsFile": "",
    "StrictHostKeyChecking": "accept-new",
    "Lab": "<lab-name>",
    "InstallRoot": ""
  },
  "KernelDebug": {
    "Transport": "kdnet",
    "Kdnet": {
      "Port": 50000,
      "Key": "<key printed by bcdedit /dbgsettings in the guest>"
    },
    "Serial": {
      "PipeName": "\\\\.\\pipe\\com_1"
    },
    "SymbolPath": "srv*%LOCALAPPDATA%\\windbg-hyperv-mcp\\symbols*https://msdl.microsoft.com/download/symbols"
  },
  "Guest": {
    "FridaPort": 27042,
    "DbgsrvPort": 5064,
    "FridaServerPath": "C:\\Tools\\frida-server.exe",
    "DbgsrvPath": "C:\\Tools\\DbgSrv\\dbgsrv.exe",
    "TtdPath": "C:\\Tools\\TTD\\TTD.exe",
    "TtdOutputDirectory": "C:\\TTD_Traces",
    "FridaToken": "",
    "DbgsrvPassword": ""
  },
  "Host": {
    "DebuggersPath": "",
    "FridaToolsPath": "",
    "OpenSshPath": ""
  },
  "Tools": {
    "Frida": false,
    "Dbgsrv": false,
    "Ttd": false
  },
  "Policy": {
    "KernelDebug": "Attended",
    "BlockHostSideEffectCommands": true,
    "HostTransferRoots": []
  },
  "Limits": {
    "MaxOutputChars": 48000
  },
  "Timeouts": {
    "VmStartSeconds": 45,
    "VmStopSeconds": 30,
    "VmPauseResumeSeconds": 10,
    "VmStatusSeconds": 30,
    "VmStateQuerySeconds": 3,
    "KdConnectSeconds": 30,
    "KdInitialBreakSeconds": 15,
    "KdBreakSeconds": 10,
    "KdStepSeconds": 10,
    "GuestCommandSeconds": 45,
    "GuestFileTransferSeconds": 45
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WinDbgMCP": "Information"
    }
  }
}
